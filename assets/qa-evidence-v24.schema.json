{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clip-short v2.4 QA evidence",
  "type": "object",
  "required": [
    "artifact_version",
    "output_sha256",
    "provenance",
    "vision_review",
    "thumbnail",
    "shot_matches",
    "human_approval"
  ],
  "properties": {
    "artifact_version": {
      "const": "2.4.0"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "git_sha",
        "git_clean",
        "renderer_source_hash",
        "dependency_lock_hash",
        "build_config_hash"
      ]
    },
    "vision_review": {
      "type": "object",
      "required": [
        "provider",
        "method",
        "model",
        "reviewer_version",
        "reviewed_output_sha256",
        "inspected_frames",
        "explanation",
        "findings"
      ],
      "properties": {
        "provider": {
          "const": "Meta Model API"
        },
        "method": {
          "const": "muse_responses_video"
        },
        "model": {
          "const": "muse-spark-1.3-contributor"
        },
        "reviewer_version": {
          "const": "2.4.0"
        },
        "reviewed_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inspected_frames": {
          "type": "array",
          "minItems": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 10
        },
        "findings": {
          "type": "array"
        },
        "timestamps": {
          "type": "array"
        },
        "evidence_frame_hashes": {
          "type": "array"
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "required": [
        "mobile_ocr_pass",
        "semantic_match",
        "headline_count"
      ]
    },
    "shot_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "active_speaker",
          "visible_person",
          "shot_type",
          "intentional_cutaway",
          "decision"
        ]
      }
    },
    "diagram_beats": {
      "type": "array"
    },
    "scene_objects": {
      "type": "array"
    },
    "human_approval": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "CHANGES_REQUESTED"
      ]
    }
  }
}
