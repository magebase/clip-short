{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta Model API",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor | 45,300",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
